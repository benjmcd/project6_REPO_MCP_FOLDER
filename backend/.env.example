APP_NAME=Method-Aware Framework
API_PREFIX=/api/v1
# Database init behavior. Defaults to migrate when unset.
# DB_INIT_MODE=none
# PostgreSQL (Tier1 operator default example):
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/method_aware
# SQLite fallback:
# DATABASE_URL=sqlite:///./method_aware.db
STORAGE_DIR=app/storage
# A8 operator runs that arm raw-bearing SEC/XBRL flags should set STORAGE_DIR=C:/p6store; guidance only, no default change.
MAX_UPLOAD_MB=64

SCIENCEBASE_API_BASE_URL=https://www.sciencebase.gov/catalog
NRC_ADAMS_APS_API_BASE_URL=https://adams-api.nrc.gov
NRC_ADAMS_APS_SUBSCRIPTION_KEY=replace_with_your_real_key

CONNECTOR_LEASE_TTL_SECONDS=120
CONNECTOR_SUBMISSION_TTL_HOURS=24
CONNECTOR_MAX_REDIRECTS=3
CONNECTOR_MAX_CONCURRENT_RUNS=1
CONNECTOR_MAX_DOWNLOADS_PER_RUN=1
CONNECTOR_PER_HOST_FETCH_LIMIT=2
# SAFETY: live connector egress remains default-off. Authority also requires
# exact protected campaign/grant/index files and caller-posture verification.
CONNECTOR_LIVE_EGRESS_ENABLED=false
CONNECTOR_LIVE_EGRESS_EXCLUSIVE_PROOF_MODE=true
CONNECTOR_EGRESS_ARMING_MAX_TTL_SECONDS=86400
# Protected inputs must be absolute regular paths outside repo/runtime/storage/web roots.
# CONNECTOR_CAMPAIGN_DEFINITION_PATH=C:/p6-authority/campaign.json
# CONNECTOR_CAMPAIGN_DEFINITION_SHA256=<lowercase-64-hex>
# CONNECTOR_SCIENCEBASE_GRANT_PATH=C:/p6-authority/sciencebase-grant.json
# CONNECTOR_SCIENCEBASE_GRANT_SHA256=<lowercase-64-hex>
# CONNECTOR_NRC_APS_GRANT_PATH=C:/p6-authority/nrc-aps-grant.json
# CONNECTOR_NRC_APS_GRANT_SHA256=<lowercase-64-hex>
# CONNECTOR_CAMPAIGN_EVIDENCE_ROOT=C:/p6-evidence
# CONNECTOR_CAMPAIGN_EVIDENCE_INDEX_PATH=C:/p6-evidence/indexes/<lowercase-64-hex>.json
# CONNECTOR_CAMPAIGN_EVIDENCE_INDEX_SHA256=<lowercase-64-hex>

# ---------------------------------------------------------------------------
# Deployment, auth, CORS, storage, and Senate-LDA configuration
# ---------------------------------------------------------------------------
# Deployment mode. 'local' = single-operator dev profile; 'nonlocal' = multi-identity
# deployment behind a trusted reverse proxy.
# DEPLOYMENT_MODE=local
#
# CORS allowed origins. Wildcard is only safe for local/dev; nonlocal deployments
# must specify explicit HTTPS origins (no wildcard).
# ALLOWED_ORIGINS=*
#
# Whether to send credentials (cookies/auth headers) in CORS responses.
# Derived from deployment mode when unset; set explicitly to override.
# CORS_ALLOW_CREDENTIALS=
#
# Storage exposure mode. 'auto' derives from deployment mode.
# Nonlocal deployments forbid 'enabled' and 'proxy_protected'; use 'disabled' or 'auto'.
# STORAGE_EXPOSURE=auto
#
# Proxy identity headers (required when AUTH_OWNER=proxy and TRUSTED_PROXY_MODE=true).
# PROXY_IDENTITY_HEADER=X-Forwarded-User
# PROXY_EMAIL_HEADER=X-Forwarded-Email
# PROXY_GROUPS_HEADER=X-Forwarded-Groups
#
# Senate LDA lobbying disclosure API. Leave SENATE_LDA_API_KEY empty for anonymous mode.
# SENATE_LDA_API_BASE_URL=https://lda.senate.gov/api/v1
# SENATE_LDA_API_KEY=

# ---------------------------------------------------------------------------
# SEC/XBRL safety flags and auth configuration
# ---------------------------------------------------------------------------
# SAFETY: live SEC/EDGAR network acquisition. Keep false unless explicitly authorized.
LAYER3_SEC_EDGAR_LIVE_NETWORK_ENABLED=false
# SAFETY: hard cap on physical live SEC requests per server process. Keep small.
LAYER3_SEC_EDGAR_MAX_LIVE_REQUESTS_PER_PROCESS=10
# Downstream Arelle fact-authority PREFERENCE only; does NOT itself spawn Arelle.
# Arelle subprocess additionally requires the flags below AND present taxonomy packages
# + cache (absent by default).
LAYER3_SEC_EDGAR_ARELLE_FACT_AUTHORITY_CUTOVER_ENABLED=true
# SAFETY: Arelle internal value store.
LAYER3_SEC_EDGAR_ARELLE_INTERNAL_VALUE_STORE_ENABLED=false
# SAFETY: live Arelle subprocess corpus validation.
LAYER3_SEC_EDGAR_ARELLE_CORPUS_VALIDATION_ENABLED=false
# SAFETY: nonlocal Arelle fact authority.
LAYER3_SEC_EDGAR_ARELLE_FACT_AUTHORITY_NONLOCAL_AUTHORIZED=false
# SAFETY: legacy Arelle value reveal.
LAYER3_SEC_EDGAR_ARELLE_VALUE_REVEAL_ENABLED=false
# SAFETY: official SEC ticker->CIK resolution for companies beyond the static 16-ticker allow-list
# on the corpus-validation path. Default OFF; enabling allows operators to admit off-list tickers
# by resolving them against SEC's official company_tickers.json (requires live network enabled).
LAYER3_SEC_EDGAR_OFFICIAL_TICKER_RESOLUTION_ENABLED=false
# SAFETY-GATED: value-reveal flags — these must remain false in production posture.
# There are two independently gated reveal paths:
# 1. Arelle-governed reveal — requires ALL of (see layer3_sec_xbrl_posture.py):
#      LAYER3_SEC_EDGAR_ARELLE_FACT_AUTHORITY_CUTOVER_ENABLED (above)
#      LAYER3_SEC_EDGAR_ARELLE_FACT_AUTHORITY_NONLOCAL_AUTHORIZED (above)
#      LAYER3_SEC_EDGAR_ARELLE_INTERNAL_VALUE_STORE_ENABLED (above)
#      LAYER3_SEC_EDGAR_ARELLE_CORPUS_VALIDATION_ENABLED (above)
#      LAYER3_SEC_EDGAR_ARELLE_VALUE_REVEAL_ENABLED (above)
# 2. Controlled value-reveal submit route — gated by the flag below.
# Both paths stay disabled. Never enable in shared/nonlocal environments without full operator review.
# Controlled value-reveal submit route. Gated by: explicit operator confirmation +
# value-reveal authority receipt + approved review decision + complete lineage +
# redaction validation + sidecar/value-store resolution (offline-staged, absent by default).
LAYER3_SEC_XBRL_CONTROLLED_VALUE_REVEAL_SUBMIT_ENABLED=false
# Narrow local override acknowledgement for temp/downloads-like SEC XBRL internal value-store roots.
# Structural hygiene failures remain blocked even when acknowledged.
LAYER3_SEC_XBRL_STORAGE_ROOT_HYGIENE_OVERRIDE_ACK=false
# 'none' = single-operator dev profile (fixed local principal).
# Set 'proxy' for multi-identity (requires TRUSTED_PROXY_MODE=true).
AUTH_OWNER=none
TRUSTED_PROXY_MODE=false
# SEC/XBRL Layer 3 production-admission evaluator (default OFF, operator-controlled).
# When unset or empty, production_admission_ready is always False (byte-identical to
# pre-evaluator behaviour). Set to 1/true/yes only after all six criteria are genuinely
# satisfiable in the target environment. Never set in CI.
SEC_XBRL_PRODUCTION_ADMISSION_EVALUATOR_ENABLED=

# World Bank Indicators anonymous public connector base URL.
# WORLDBANK_API_BASE_URL=https://api.worldbank.org/v2

# CFTC Commitment of Traders anonymous public connector current-file base URL.
# CFTC_COT_API_BASE_URL=https://www.cftc.gov/dea/newcot

# BLS Public Data API v1 anonymous connector runtime base URL.
# BLS_API_BASE_URL=https://api.bls.gov/publicAPI/v1/timeseries/data

# OECD SDMX anonymous connector runtime base URL.
# OECD_SDMX_API_BASE_URL=https://sdmx.oecd.org/public/rest/data
