# =============================================================================
# Layer 3 — Production Environment Template
# =============================================================================
# Copy to .env before deploying.  Every placeholder marked <REPLACE> MUST be
# set before the server will pass the nonlocal deployment-profile validator
# (see backend/app/core/config.py _validate_deployment_profile).
#
# Master switch: nonlocal enables the fail-closed multi-identity profile.
# All validator requirements below derive from this setting.
DEPLOYMENT_MODE=nonlocal

# ---------------------------------------------------------------------------
# Identity and proxy trust (required by nonlocal validator)
# ---------------------------------------------------------------------------
# AUTH_OWNER=proxy and TRUSTED_PROXY_MODE=true are both required when
# DEPLOYMENT_MODE=nonlocal (config.py lines 242-245).
AUTH_OWNER=proxy
TRUSTED_PROXY_MODE=true

# Headers injected by the trusted reverse proxy carrying operator identity.
# PROXY_IDENTITY_HEADER is mandatory for nonlocal (config.py line 246-247).
PROXY_IDENTITY_HEADER=X-Forwarded-User
PROXY_EMAIL_HEADER=X-Forwarded-Email
PROXY_GROUPS_HEADER=X-Forwarded-Groups

# ---------------------------------------------------------------------------
# Route authorization (role-enforcing requires PROXY_ROLES_HEADER)
# config.py lines 260-267: role_enforcing requires proxy_roles_header set.
# ---------------------------------------------------------------------------
LAYER3_ROUTE_AUTHORIZATION_MODE=role_enforcing
PROXY_ROLES_HEADER=X-Forwarded-Roles
LAYER3_OWNER_ROLE_TOKENS=owner
LAYER3_AUDITOR_ROLE_TOKENS=auditor

# ---------------------------------------------------------------------------
# Database (SQLite is forbidden when DEPLOYMENT_MODE=nonlocal — config.py 258)
# ---------------------------------------------------------------------------
DB_INIT_MODE=migrate
DATABASE_URL=postgresql+psycopg://<REPLACE_USER>:<REPLACE_PASSWORD>@<REPLACE_HOST>:5432/<REPLACE_DBNAME>

# ---------------------------------------------------------------------------
# CORS — wildcard is forbidden when DEPLOYMENT_MODE=nonlocal (config.py 238-241).
# Must be explicit HTTPS origins only.
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=https://<REPLACE_YOUR_DOMAIN>
CORS_ALLOW_CREDENTIALS=true

# Storage: nonlocal forbids 'enabled' and 'proxy_protected' (config.py 248-249).
STORAGE_EXPOSURE=auto

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# Emit structured JSON log lines (consumed by log aggregation pipelines).
LAYER3_LOG_FORMAT=json

# ---------------------------------------------------------------------------
# Activated production capabilities
# (Each flag below is intentionally ON — justification inline)
# ---------------------------------------------------------------------------

# Live SEC/EDGAR network acquisition.
# ON: production deployments must reach SEC EDGAR for live filing data.
LAYER3_SEC_EDGAR_LIVE_NETWORK_ENABLED=true

# SEC user-agent string (required by SEC fair-access policy when live network is on).
LAYER3_SEC_EDGAR_USER_AGENT=<REPLACE_ORGNAME> <REPLACE_CONTACT_EMAIL>

# Arelle fact-authority preference cutover.
# ON: production uses Arelle as the downstream fact authority (preference only —
# does not itself invoke Arelle without the five conjunction flags below).
LAYER3_SEC_EDGAR_ARELLE_FACT_AUTHORITY_CUTOVER_ENABLED=true

# Nonlocal Arelle fact-authority authorization.
# Required by nonlocal validator when cutover is enabled (config.py 250-257).
LAYER3_SEC_EDGAR_ARELLE_FACT_AUTHORITY_NONLOCAL_AUTHORIZED=true

# Official SEC ticker->CIK resolution (company_tickers.json).
# ON: production must resolve tickers beyond the static 16-ticker allow-list;
# requires live network to be enabled above.
LAYER3_SEC_EDGAR_OFFICIAL_TICKER_RESOLUTION_ENABLED=true

# Analysis product package inventory projection.
# ON: production surfaces the full package inventory to authorized operators.
LAYER3_ANALYSIS_PRODUCT_PACKAGE_INVENTORY_ENABLED=true

# SEC/XBRL production-admission evaluator.
# ON: activates the six-criteria admission evaluator; evaluate to true only
# when all six criteria are genuinely satisfiable in this environment.
# Never set in CI.
SEC_XBRL_PRODUCTION_ADMISSION_EVALUATOR_ENABLED=true

# ---------------------------------------------------------------------------
# PERMANENTLY GATED — value-reveal conjunction flags
# ---------------------------------------------------------------------------
# The five flags below form the Arelle invocation + governed sibling value-reveal
# conjunction (posture.py _arelle_invocation_surface, lines 281-286).
# ALL FIVE must be true simultaneously to enable Arelle invocation and any
# value reveal.  These are PERMANENTLY GATED in this template:
#   - They must NEVER be set to true without explicit operator authorization,
#     a value-reveal authority receipt, an approved review decision, complete
#     lineage, redaction validation, and sidecar/value-store resolution.
#   - They are NEVER set in CI.
#   - Setting any of these to true without the full conjunction is a no-op for
#     Arelle invocation but could widen surface area; keep false until all five
#     are genuinely satisfiable.
LAYER3_SEC_EDGAR_ARELLE_INTERNAL_VALUE_STORE_ENABLED=false
LAYER3_SEC_EDGAR_ARELLE_CORPUS_VALIDATION_ENABLED=false
LAYER3_SEC_EDGAR_ARELLE_VALUE_REVEAL_ENABLED=false
LAYER3_SEC_XBRL_CONTROLLED_VALUE_REVEAL_SUBMIT_ENABLED=false
# (LAYER3_SEC_EDGAR_ARELLE_FACT_AUTHORITY_NONLOCAL_AUTHORIZED is set above to
# satisfy the nonlocal validator; the remaining four must all be true to unlock
# Arelle invocation — they remain false here.)

# ---------------------------------------------------------------------------
# Other runtime limits (mirrors .env.example defaults)
# ---------------------------------------------------------------------------
APP_NAME=Method-Aware Framework
API_PREFIX=/api/v1
STORAGE_DIR=app/storage
MAX_UPLOAD_MB=64
CONNECTOR_LEASE_TTL_SECONDS=120
CONNECTOR_SUBMISSION_TTL_HOURS=24
CONNECTOR_MAX_REDIRECTS=3
CONNECTOR_MAX_CONCURRENT_RUNS=1
CONNECTOR_MAX_DOWNLOADS_PER_RUN=1
CONNECTOR_PER_HOST_FETCH_LIMIT=2
SCIENCEBASE_API_BASE_URL=https://www.sciencebase.gov/catalog
NRC_ADAMS_APS_API_BASE_URL=https://adams-api.nrc.gov
NRC_ADAMS_APS_SUBSCRIPTION_KEY=<REPLACE_IF_USED>

# ---------------------------------------------------------------------------
# Signed-reference HMAC secret
# Purpose: HMAC key for signed external-export delivery references.
# Without it, signed-reference routes stay 409-blocked.
# ---------------------------------------------------------------------------
LAYER3_SIGNED_REFERENCE_SECRET=<REPLACE_WITH_64_HEX_CHARS>

# ---------------------------------------------------------------------------
# External local export directory
# Must be an absolute path outside STORAGE_DIR and the outbox.
# In the compose stack this defaults to /app/export-outbox (named volume).
# ---------------------------------------------------------------------------
LAYER3_EXTERNAL_LOCAL_EXPORT_DIR=/app/export-outbox
