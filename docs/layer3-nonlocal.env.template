# Layer 3 non-local deployment profile template.
# Copy values into the selected deployment environment or secret manager.
# Do not commit a filled copy of this template.

DEPLOYMENT_MODE=nonlocal
ALLOWED_ORIGINS=<exact-https-origin-list>
CORS_ALLOW_CREDENTIALS=false
AUTH_OWNER=proxy
PROXY_IDENTITY_HEADER=X-Forwarded-User
# Required for the Layer 3 workbench POST surface under proxy posture: the
# in-app operator-identity seam derives workspace authority from this header
# and rejects requests without it (401). The proxy must supply it and strip
# or overwrite any client-supplied value.
PROXY_GROUPS_HEADER=X-Forwarded-Groups
TRUSTED_PROXY_MODE=true
STORAGE_EXPOSURE=auto
DB_INIT_MODE=none

# Route-level role authorization (Phase 1). Default is identity_presence (inert:
# no role check; safe to leave as-is until the proxy provisions a roles header).
# Set to role_enforcing to activate owner/auditor access-class enforcement.
# LAYER3_ROUTE_AUTHORIZATION_MODE=identity_presence

# Header carrying comma-separated role tokens from the reverse proxy.
# Required (nonblank) when LAYER3_ROUTE_AUTHORIZATION_MODE=role_enforcing.
# The proxy must strip or overwrite any client-supplied value for this header.
# PROXY_ROLES_HEADER=X-Forwarded-Roles

# Comma-separated token strings that map to the owner role (read + write).
# LAYER3_OWNER_ROLE_TOKENS=owner

# Comma-separated token strings that map to the auditor role (read only).
# LAYER3_AUDITOR_ROLE_TOKENS=auditor

# Optional proxy-owned metadata header. Leave unset unless the proxy supplies
# trustworthy values and strips or overwrites any client-supplied equivalents.
# PROXY_EMAIL_HEADER=X-Forwarded-Email
