# htpasswd.example — Example Basic Auth password file for nginx
#
# DO NOT USE THIS FILE DIRECTLY IN PRODUCTION.
# Copy it to deploy/proxy/htpasswd (untracked by git) and replace with real
# bcrypt hashes generated via:
#
#   docker run --rm httpd:2.4-alpine htpasswd -nbB <username> <password>
#
# Example: generate a hash for user "alice":
#   docker run --rm httpd:2.4-alpine htpasswd -nbB alice mysecretpassword
#
# Append each output line to deploy/proxy/htpasswd.
# Each line must be in the format:
#   username:$2y$<bcrypt_hash>
#
# The example lines below use FAKE hashes — replace them before running.

alice-owner:$2y$10$FAKEHASHFAKEHASHFAKEHASHFAKEHASHFAKEHASHFAKEHASHFAKE0A
bob-auditor:$2y$10$FAKEHASHFAKEHASHFAKEHASHFAKEHASHFAKEHASHFAKEHASHFAKE0B
