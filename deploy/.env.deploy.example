# deploy/.env.deploy.example — Operator-owned deploy-time knobs
#
# Copy this file to deploy/.env (NOT committed to git) and fill in every
# <REPLACE> value before running:
#
#   docker compose -f deploy/docker-compose.production.yml --env-file deploy/.env up -d --build

# ---------------------------------------------------------------------------
# Database password (used by both db and app services)
#
# MUST be URL-safe: the compose file embeds it in a SQLAlchemy URL, so use
# only [A-Za-z0-9_-] (32+ chars of hex is ideal). Characters like @ : / ? # %
# would misparse the URL even though postgres itself accepts them. If you
# truly need such characters, set the full DATABASE_URL below instead, with
# the password percent-encoded.
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=<REPLACE_WITH_STRONG_RANDOM_URL_SAFE_PASSWORD>

# Optional override: full DSN for the app (takes precedence over the
# compose-built default). Only needed for non-URL-safe passwords or an
# external database host.
# DATABASE_URL=postgresql+psycopg://app:<PERCENT_ENCODED_PASSWORD>@db:5432/layer3

# ---------------------------------------------------------------------------
# Proxy host port (the port exposed on the host machine)
# Default: 8080. In production behind a TLS-terminating LB, set to 80.
# ---------------------------------------------------------------------------
PROXY_HTTP_PORT=8080

# ---------------------------------------------------------------------------
# CORS allowed origins (must be explicit HTTPS — no wildcard)
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=https://<REPLACE_YOUR_DOMAIN>

# ---------------------------------------------------------------------------
# SEC EDGAR live network (default false — operator enables when ready)
# When enabling, LAYER3_SEC_EDGAR_USER_AGENT is required by SEC fair-access policy.
# ---------------------------------------------------------------------------
LAYER3_SEC_EDGAR_LIVE_NETWORK_ENABLED=false
# LAYER3_SEC_EDGAR_USER_AGENT=<REPLACE_ORG_NAME> <REPLACE_CONTACT_EMAIL>

# ---------------------------------------------------------------------------
# Signed-reference HMAC secret
#
# Required to enable the external-export signed-reference download surface.
# Without it, signed-reference routes stay 409-blocked (safe default).
#
# Generate with one of:
#   docker run --rm alpine sh -c 'head -c 32 /dev/urandom | od -An -tx1 | tr -d " \n"'
#   openssl rand -hex 32
# ---------------------------------------------------------------------------
# LAYER3_SIGNED_REFERENCE_SECRET=<REPLACE_WITH_64_HEX_CHARS>

# ---------------------------------------------------------------------------
# SEC EDGAR official ticker->CIK resolution (company_tickers.json)
#
# Enables resolution beyond the static 16-ticker allow-list.
# Production-posture default (matches backend/.env.production.example) —
# it is a NO-OP until LAYER3_SEC_EDGAR_LIVE_NETWORK_ENABLED=true above;
# enable the two together when going live.
# ---------------------------------------------------------------------------
LAYER3_SEC_EDGAR_OFFICIAL_TICKER_RESOLUTION_ENABLED=true

# ---------------------------------------------------------------------------
# Analysis product package inventory projection
#
# Surfaces the full package inventory to authorized operators.
# ---------------------------------------------------------------------------
LAYER3_ANALYSIS_PRODUCT_PACKAGE_INVENTORY_ENABLED=true

# ---------------------------------------------------------------------------
# Export outbox path override (optional)
#
# Defaults to /app/export-outbox (the export_data named volume).
# Override only when mounting a host path or external volume at a different
# container path.  Must be absolute and outside STORAGE_DIR.
# ---------------------------------------------------------------------------
# LAYER3_EXTERNAL_LOCAL_EXPORT_DIR=/app/export-outbox

# ===========================================================================
# APPLICATION IDENTITY (optional — defaults shown)
# ===========================================================================

# Human-readable name surfaced in API metadata responses.
# Default: Method-Aware Framework
# APP_NAME=Method-Aware Framework

# URL prefix for all API routes.
# Default: /api/v1
# API_PREFIX=/api/v1

# ===========================================================================
# UPLOAD LIMITS (optional — default shown)
# ===========================================================================

# Maximum multipart upload size in megabytes.
# Must match (or be lower than) client_max_body_size in proxy/nginx.conf (64m).
# Default: 64
# MAX_UPLOAD_MB=64

# ===========================================================================
# CONNECTOR RUNTIME LIMITS (optional — defaults shown)
# ===========================================================================

# Seconds a connector lease is held before it is forcibly released.
# Default: 120
# CONNECTOR_LEASE_TTL_SECONDS=120

# Hours a connector submission record is retained before expiry.
# Default: 24
# CONNECTOR_SUBMISSION_TTL_HOURS=24

# Maximum HTTP redirects followed per connector fetch request.
# Default: 3
# CONNECTOR_MAX_REDIRECTS=3

# Maximum number of connector pipeline runs that may execute simultaneously.
# Default: 1
# CONNECTOR_MAX_CONCURRENT_RUNS=1

# Maximum file downloads permitted within a single connector run.
# Default: 1
# CONNECTOR_MAX_DOWNLOADS_PER_RUN=1

# Maximum fetch requests allowed to the same host within a single connector run.
# Default: 2
# CONNECTOR_PER_HOST_FETCH_LIMIT=2

# ===========================================================================
# NRC ADAMS APS CONNECTOR (optional — defaults shown)
# ===========================================================================

# Base URL for the NRC ADAMS APS REST API.
# Default: https://adams-api.nrc.gov
# NRC_ADAMS_APS_API_BASE_URL=https://adams-api.nrc.gov

# Ocp-Apim-Subscription-Key header value for the NRC ADAMS APS API.
# Required when the NRC APS connector is actively used; leave empty to disable.
# Default: (empty — connector non-functional without key)
# NRC_ADAMS_APS_SUBSCRIPTION_KEY=<REPLACE_IF_USED>

# ===========================================================================
# SCIENCEBASE CONNECTOR (optional — default shown)
# ===========================================================================

# Base URL for the USGS ScienceBase catalog REST API.
# Default: https://www.sciencebase.gov/catalog
# SCIENCEBASE_API_BASE_URL=https://www.sciencebase.gov/catalog

# ===========================================================================
# SENATE LDA CONNECTOR (optional — defaults shown)
# ===========================================================================

# Base URL for the Senate Lobbying Disclosure Act (LDA) REST API.
# Default: https://lda.senate.gov/api/v1
# SENATE_LDA_API_BASE_URL=https://lda.senate.gov/api/v1

# API key for the Senate LDA API.
# Required when the Senate LDA connector is actively used; leave empty to disable.
# Default: (empty — connector non-functional without key)
# SENATE_LDA_API_KEY=<REPLACE_IF_USED>

# ===========================================================================
# SEC EDGAR RATE LIMITS AND FETCH LIMITS (optional — defaults shown)
# ===========================================================================

# Maximum EDGAR HTTP requests per second (SEC fair-access policy: ≤ 10/s).
# Default: 1
# LAYER3_SEC_EDGAR_RATE_LIMIT_PER_SECOND=1

# Maximum bytes fetched per EDGAR document request.
# Default: 25000000  (25 MB)
# LAYER3_SEC_EDGAR_MAX_BYTES=25000000

# HTTP timeout in seconds for individual EDGAR fetch requests.
# Default: 20
# LAYER3_SEC_EDGAR_TIMEOUT_SECONDS=20

# ===========================================================================
# INTERNAL WEBHOOK (optional — empty = disabled)
# ===========================================================================

# URL of an internal webhook endpoint to receive server-side event notifications.
# Leave empty (the default) to disable outbound webhook calls entirely.
# Default: (empty)
# LAYER3_INTERNAL_WEBHOOK_URL=

# Display name embedded in webhook payloads to identify this server instance.
# Default: server-configured-internal-webhook
# LAYER3_INTERNAL_WEBHOOK_DISPLAY_NAME=server-configured-internal-webhook
